# Cloudinary console > API Keys > "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# The app's website and the shared worker password (same value as WORKER_SECRET in Vercel).
# When both are set the worker takes orders from the app instead of Cloudinary job files.
INVITE_API_URL=https://quickinvitations.vercel.app
WORKER_SECRET=

# Only needed for reading card photos
ANTHROPIC_API_KEY=
# "Most accurate" and "Approximate" models
# INVITE_AI_MODEL=claude-sonnet-5-5
# INVITE_AI_MODEL_FAST=claude-haiku-5-5

# Folder prefix used in Cloudinary
INVITE_CLOUDINARY_FOLDER=invites

# How often to look for new orders when nothing is happening (minutes). Lower = faster first video,
# but keeps the free database awake longer. Below ~6 the database never sleeps.
# INVITE_IDLE_POLL_MINUTES=15
