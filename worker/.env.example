# Cloudinary console > API Keys > "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Only needed for jobs with card_image_url (reading a card photo)
ANTHROPIC_API_KEY=
# INVITE_AI_MODEL=claude-sonnet-5-5

# Folder prefix used in Cloudinary
INVITE_CLOUDINARY_FOLDER=invites
