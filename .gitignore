# secrets and local settings
.env
!.env.example
**/.env
# worker local files
worker/.venv/
worker/output/
worker/logs/
worker/tools/
worker/jobs/inbox/
__pycache__/
# generated previews
worker/templates/*/preview.jpg
worker/templates/*/preview.mp4
# media that must not be public (purchased / third-party). Keep your own copies locally.
worker/templates/rose_gold/background.mp4
worker/templates/**/music.m4a
worker/templates/**/*.mp3
# generated (original) music for the new designs is fine to share
!worker/templates/birthday_confetti/music.m4a
!worker/templates/cradle_moonlight/music.m4a
!worker/templates/babyshower_blush/music.m4a
# half-rendered backgrounds
*.part.mp4
